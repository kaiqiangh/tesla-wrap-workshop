# Public site origin for canonical links. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# Environment identity used to reject accidental environment pairing.
WRAPFORGE_ENVIRONMENT=

# Browser-visible environment identity; must match WRAPFORGE_ENVIRONMENT.
NEXT_PUBLIC_WRAPFORGE_ENVIRONMENT=

# Supabase Data API URL for the matching Environment Pair.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key for browser-safe Data API access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key; never expose it to browser code.
SUPABASE_SECRET_KEY=

# Server-only HMAC key (at least 32 chars), separate from the JWT secret in hosted environments.
DOWNLOAD_PRINCIPAL_HMAC_SECRET=

# Required outside local mode; Vercel Cron uses it to refresh Trending state hourly.
CRON_SECRET=
