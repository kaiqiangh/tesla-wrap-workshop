{
  "name": "wrapforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "next build",
    "build:local": "node scripts/with-local-supabase.mjs pnpm build",
    "dev": "next dev",
    "dev:local": "node scripts/with-local-supabase.mjs pnpm dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "scan:security": "node scripts/security-scan.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:browser": "supabase db reset && node scripts/with-local-supabase.mjs pnpm exec playwright test --project=chromium --project=desktop-1440 --project=mobile-chrome",
    "test:browser:compat": "supabase db reset && node scripts/with-local-supabase.mjs pnpm exec playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:browser:full": "supabase db reset && node scripts/with-local-supabase.mjs pnpm exec playwright test",
    "test:browser:local": "pnpm test:browser",
    "test:db": "supabase db reset && supabase test db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
